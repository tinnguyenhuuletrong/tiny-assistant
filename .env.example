# Copy to .env (Bun loads it automatically). Everything is optional.

# Where the daemon listens. Keep 127.0.0.1 and use `make tailscale-serve` for HTTPS on your tailnet,
# or set 0.0.0.0 to accept tailnet clients directly (non-tailnet addresses are still refused).
TINY_HOST=127.0.0.1
TINY_PORT=7777

# Database and logs. One SQLite file holds pi-durable's transcripts and the app's tables.
TINY_DATA_DIR=~/.tiny-assistant

# Your tools and workflows (hot-reloaded). Defaults to ./assistant in this repo.
# TINY_ASSISTANT_DIR=~/my-assistant

# Model providers: claude-code uses your Claude Pro/Max login (`claude auth login`).
# Add pi-ai providers with their usual keys, e.g. TINY_PROVIDERS=claude-code,openai plus OPENAI_API_KEY.
TINY_PROVIDERS=claude-code
# TINY_DEFAULT_MODEL=claude-code/claude-sonnet-5-5

# Folders the project picker may browse (comma separated).
TINY_FS_ROOTS=~

# Access control. Loopback and tailnet addresses are required unless TINY_ALLOW_ANY_NETWORK=1.
# TINY_TOKEN=change-me                      # require a token (Bearer header or ?token=)
# TINY_ALLOWED_LOGINS=you@example.com       # Tailscale identities allowed through `tailscale serve`
# TINY_ALLOWED_HOSTS=assistant.example.com  # extra Host names (IPs, localhost, *.local, *.ts.net always work)
# TINY_ALLOWED_ORIGINS=https://my.proxy     # extra browser origins allowed to make changes
